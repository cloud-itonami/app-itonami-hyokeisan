(ns hyokeisan.sheet (:export [main]))
;; Bounded local workbook candidate: 4x4 cells, text, signed integers,
;; =A1 references, binary +, - or * and =SUM(A1:B2). Unrecognized or cyclic
;; formulas produce an error; no host operation or external format is implied.
(defn dget [d :document k :keyword] :document
  (option-value-of [:option :document] (document-get d k) (document-null)))
(defn dstr [d :document] :string
  (option-value-of [:option :string] (document-string-value d) ""))
(defn dat [v :document i :i64] :document
  (option-value-of [:option :document] (document-vector-at v i) (document-null)))
(defn init [] :document
  (document-vector (document-string "") (document-string "") (document-string "") (document-string "")
                   (document-string "") (document-string "") (document-string "") (document-string "")
                   (document-string "") (document-string "") (document-string "") (document-string "")
                   (document-string "") (document-string "") (document-string "") (document-string "")))
(defn cell-text [s :document i :i64] :string (dstr (dat s i)))
(defn index-key [i :i64] :string (string-concat "c" (string-from-i64 i)))
(defn key-index [key :string i :i64] :i64
  (if (= i 16) -1 (if (string=? key (index-key i)) i (key-index key (+ i 1)))))
(defn step [s :document target :string kind :string value :string] :document
  (let [i (key-index target 0)]
    (if (and (string=? kind "input") (>= i 0) (<= (string-byte-length value) 128))
      (document-vector-assoc s i (document-string value)) s)))
(defn ref-index [s :string] :i64
  (if (not= (string-byte-length s) 2) -1
    (let [c (string-code-point-at s 0)]
      ;; Byte offset 1 is a boundary only if the first code point is ASCII.
      (if (or (< c 65) (> c 68)) -1
        (let [r (string-code-point-at s 1)]
          (if (and (>= r 49) (<= r 52)) (+ (* (- r 49) 4) (- c 65)) -1))))))
;; Internal scale: one million units per integer. Input cells remain strings.
;; Results requiring more than six decimal places fail instead of rounding.
(defn decimal-padding [v :i64 places :i64] :i64
  (if (= places 6) v (decimal-padding (* v 10) (+ places 1))))
(defn decimal-digits [s :string i :i64 n :i64 whole :i64 fraction :i64 places :i64 dot :bool digits :i64] [:option :i64]
  (if (= i n)
    (if (= digits 0) (option-none-of [:option :i64])
      (option-some-of [:option :i64] (+ (* whole 1000000) (decimal-padding fraction places))))
    (let [c (string-code-point-at s i)]
      (cond
        (= c 46) (if dot (option-none-of [:option :i64]) (decimal-digits s (+ i 1) n whole fraction places true digits))
        (or (< c 48) (> c 57)) (option-none-of [:option :i64])
        dot (if (>= places 6) (option-none-of [:option :i64])
              (decimal-digits s (+ i 1) n whole (+ (* fraction 10) (- c 48)) (+ places 1) true (+ digits 1)))
        :else (let [next (+ (* whole 10) (- c 48))]
                (if (> next 999999) (option-none-of [:option :i64])
                  (decimal-digits s (+ i 1) n next fraction places false (+ digits 1))))))))
(defn parse-number [s :string] [:option :i64]
  (let [n (string-byte-length s)]
    (if (= n 0) (option-some-of [:option :i64] 0)
      (let [neg (= (string-code-point-at s 0) 45) start (if neg 1 0)]
        (if (or (= start n) (> n 14)) (option-none-of [:option :i64])
          (let [v (decimal-digits s start n 0 0 0 false 0)]
            (if (option-some?-of [:option :i64] v)
              (option-some-of [:option :i64] (* (if neg -1 1) (option-value-of [:option :i64] v 0)))
              (option-none-of [:option :i64]))))))))
(defn decimal-sign [a :i64 b :i64 value :i64] :i64
  (if (or (and (< a 0) (> b 0)) (and (> a 0) (< b 0))) (- 0 value) value))
(defn decimal-abs [v :i64] :i64 (if (< v 0) (- 0 v) v))
(defn decimal-multiply [a :i64 b :i64] [:option :i64]
  (let [x (decimal-abs a) y (decimal-abs b) aq (quot x 1000000) ar (rem x 1000000)
        bq (quot y 1000000) br (rem y 1000000) product (* aq bq) tail (* ar br)]
    (if (or (> product 1000000000) (not (= (rem tail 1000000) 0))) (option-none-of [:option :i64])
      (let [total (+ (+ (* product 1000000) (* aq br)) (+ (* bq ar) (quot tail 1000000)))]
        (if (> total 1000000000000000) (option-none-of [:option :i64])
          (option-some-of [:option :i64] (decimal-sign a b total)))))))
(defn decimal-div-digits [r :i64 divisor :i64 i :i64 value :i64] [:option :i64]
  (if (= i 6)
    (if (= r 0) (option-some-of [:option :i64] value) (option-none-of [:option :i64]))
    (let [next (* r 10)]
      (decimal-div-digits (rem next divisor) divisor (+ i 1) (+ (* value 10) (quot next divisor))))))
(defn exact-divide [a :i64 b :i64] [:option :i64]
  (if (= b 0) (option-none-of [:option :i64])
    (let [x (decimal-abs a) y (decimal-abs b) whole (quot x y)]
      (if (> whole 1000000000) (option-none-of [:option :i64])
        (let [fraction (decimal-div-digits (rem x y) y 0 0)
              total (+ (* whole 1000000) (option-value-of [:option :i64] fraction 0))]
          (if (or (not (option-some?-of [:option :i64] fraction)) (> total 1000000000000000))
            (option-none-of [:option :i64])
            (option-some-of [:option :i64] (decimal-sign a b total))))))))
(defn decimal-trim [s :string end :i64] :i64
  (if (and (> end 0) (= (string-code-point-at s (- end 1)) 48)) (decimal-trim s (- end 1)) end))
(defn format-number [v :i64] :string
  (let [x (decimal-abs v) whole (quot x 1000000) fraction (rem x 1000000)
        prefix (string-concat (if (< v 0) "-" "") (string-from-i64 whole))]
    (if (= fraction 0) prefix
      (let [padded (string-substring (string-from-i64 (+ 1000000 fraction)) 1 7)
            end (decimal-trim padded 6)]
        (string-concat prefix (string-concat "." (string-substring padded 0 end)))))))
;; SUM may ignore clearly nonnumeric literal text, but must not silently skip
;; formulas, error values, or unsupported numeric-looking representations.
(defn sum-ignored-text? [s :string] :bool
  (let [n (string-byte-length s)
        start (loop [i 0]
                (if (>= i n) i
                  (let [c (string-code-point-at s i)]
                    (if (or (= c 32) (= c 9) (= c 10) (= c 13)) (recur (+ i 1)) i))))]
    (if (= start n) true
      (let [c (string-code-point-at s start)]
        (not (or (= c 61) (= c 35) (= c 43) (= c 45) (= c 46)
                 (and (>= c 48) (<= c 57))))))))
(defn eval-token [s :document token :string seen :i64] [:option :i64]
  (if (= (string-byte-length token) 0) (option-none-of [:option :i64])
    (let [i (ref-index token)]
      (if (>= i 0) (eval-cell s i seen) (parse-number token)))))
(defn sum-range [s :document r :i64 c :i64 r0 :i64 c0 :i64 r1 :i64 c1 :i64 seen :i64 total :i64] [:option :i64]
  (if (> r r1) (option-some-of [:option :i64] total)
    (if (> c c1) (sum-range s (+ r 1) c0 r0 c0 r1 c1 seen total)
      (let [v (eval-cell s (+ (* r 4) c) seen)]
        (if (not (option-some?-of [:option :i64] v))
          (if (sum-ignored-text? (cell-text s (+ (* r 4) c)))
            (sum-range s r (+ c 1) r0 c0 r1 c1 seen total) (option-none-of [:option :i64]))
          (let [next (+ total (option-value-of [:option :i64] v 0))]
            (if (or (< next -1000000000000000) (> next 1000000000000000)) (option-none-of [:option :i64])
              (sum-range s r (+ c 1) r0 c0 r1 c1 seen next))))))))
;; A binary operator must follow the first token: its leading minus is a sign.
;; Results are bounded before they can be used as operands by another cell.
(defn binary-minus-index [expr :string] :i64
  (let [n (string-byte-length expr) p (string-index-of expr "-")]
    (if (not= p 0) p
      (if (<= n 1) -1
        (let [next (string-index-of (string-substring expr 1 n) "-")]
          (if (< next 0) -1 (+ next 1)))))))
(defn eval-binary [s :document expr :string seen :i64 op :string pos :i64] [:option :i64]
  (let [n (string-byte-length expr)]
    (if (or (<= pos 0) (>= pos (- n 1))) (option-none-of [:option :i64])
      (let [a (eval-token s (string-substring expr 0 pos) seen)
            b (eval-token s (string-substring expr (+ pos 1) n) seen)
            av (option-value-of [:option :i64] a 0) bv (option-value-of [:option :i64] b 0)
            total (if (string=? op "-") (- av bv) 0)]
        (if (and (option-some?-of [:option :i64] a) (option-some?-of [:option :i64] b)
                 (or (string=? op "/") (string=? op "*") (and (>= total -1000000000000000) (<= total 1000000000000000))))
          (cond (string=? op "/") (exact-divide av bv) (string=? op "*") (decimal-multiply av bv) :else (option-some-of [:option :i64] total))
          (option-none-of [:option :i64]))))))
;; Grammar offsets below are byte offsets for ASCII tokens. Refuse non-ASCII
;; formulas as values before taking any fixed-width substring; text cells may
;; still contain arbitrary UTF-8. Never probe inside a multi-byte code point.
(defn ascii-formula? [s :string i :i64 n :i64] :bool
  (if (= i n) true
    (if (< (string-code-point-at s i) 128) (ascii-formula? s (+ i 1) n) false)))
(defn eval-form [s :document formula :string seen :i64] [:option :i64]
  (if (ascii-formula? formula 0 (string-byte-length formula))
    (eval-ascii-form s formula seen) (option-none-of [:option :i64])))
(defn eval-ascii-form [s :document formula :string seen :i64] [:option :i64]
  (let [n (string-byte-length formula)]
    (if (and (= n 11) (string=? (string-substring formula 0 5) "=SUM(")
             (string=? (string-substring formula 7 8) ":") (string=? (string-substring formula 10 11) ")"))
      (let [a (ref-index (string-substring formula 5 7)) b (ref-index (string-substring formula 8 10))]
        (if (or (< a 0) (< b 0) (> (quot a 4) (quot b 4)) (> (rem a 4) (rem b 4)))
          (option-none-of [:option :i64])
          (sum-range s (quot a 4) (rem a 4) (quot a 4) (rem a 4) (quot b 4) (rem b 4) seen 0)))
      (let [expr (string-substring formula 1 n) plus (string-index-of expr "+")]
        (if (< plus 0)
          (let [times (string-index-of expr "*") slash (string-index-of expr "/") minus (binary-minus-index expr)]
            (cond (>= times 0) (eval-binary s expr seen "*" times)
                  (>= slash 0) (eval-binary s expr seen "/" slash)
                  (>= minus 0) (eval-binary s expr seen "-" minus)
                  :else (eval-token s expr seen)))
          (if (or (= plus 0) (= plus (- (string-byte-length expr) 1))) (option-none-of [:option :i64])
            (let [a (eval-token s (string-substring expr 0 plus) seen)
                  b (eval-token s (string-substring expr (+ plus 1) (string-byte-length expr)) seen)
                  total (+ (option-value-of [:option :i64] a 0) (option-value-of [:option :i64] b 0))]
              (if (and (option-some?-of [:option :i64] a) (option-some?-of [:option :i64] b)
                       (>= total -1000000000000000) (<= total 1000000000000000))
                (option-some-of [:option :i64] total) (option-none-of [:option :i64])))))))))
(defn eval-cell [s :document i :i64 seen :i64] [:option :i64]
  (let [flag (i64-shift-left 1 i) text (cell-text s i) n (string-byte-length text)]
    (if (not= (bit-and seen flag) 0) (option-none-of [:option :i64])
      (if (and (> n 0) (= (string-code-point-at text 0) 61))
        (eval-form s text (bit-or seen flag)) (parse-number text)))))
(defn shown [s :document i :i64] :string
  (let [text (cell-text s i) n (string-byte-length text)]
    (if (and (> n 0) (= (string-code-point-at text 0) 61))
      (let [v (eval-cell s i 0)] (if (option-some?-of [:option :i64] v) (format-number (option-value-of [:option :i64] v 0)) "#ERROR"))
      text)))
(defn el [tag :string attrs :document children :document] :document
  (document-map :tag (document-string tag) :attrs attrs :children children))
(defn leaf [tag :string attrs :document text :string] :document
  (document-map :tag (document-string tag) :attrs attrs :text (document-string text)))
(defn name-cell [i :i64] :string
  (string-concat (if (= (rem i 4) 0) "A" (if (= (rem i 4) 1) "B" (if (= (rem i 4) 2) "C" "D"))) (string-from-i64 (+ 1 (quot i 4)))))
(defn view-cells [s :document i :i64 acc :document] :document
  (if (= i 16) acc
    (view-cells s (+ i 1)
      (document-vector-conj acc
        (el "div" (document-map :class (document-string "cell"))
          (document-vector (leaf "span" (document-map :class (document-string "label")) (name-cell i))
            (leaf "input" (document-map :data-k (document-string (index-key i)) :type (document-string "text")
                                       :aria-label (document-string (string-concat "セル " (name-cell i)))
                                       :value (document-string (cell-text s i))) "")
            (leaf "span" (document-map :class (document-string "value")) (shown s i))))))))
(defn view [s :document] :document
  (el "div" (document-map :class (document-string "sheet"))
    (document-vector (leaf "h1" (document-map) "itonami Hyokeisan")
                     (el "div" (document-map :class (document-string "tools"))
                         (document-vector
                          (leaf "button" (document-map :type (document-string "button") :data-k (document-string "backup-export")) "バックアップ")
                          (leaf "button" (document-map :type (document-string "button") :data-k (document-string "backup-import")) "読み込む")
                          (leaf "button" (document-map :type (document-string "button") :data-k (document-string "backup-restore")) "読み込み前に戻す")
                          (leaf "button" (document-map :type (document-string "button") :data-k (document-string "workbook-upgrade")) "複数シートへ移行")))
                     (el "main" (document-map :class (document-string "grid")) (view-cells s 0 (document-vector))))))
(defn test-sheet [] :i64
  (let [s (step (step (step (step (step (init) "c0" "input" "3") "c1" "input" "4") "c4" "input" "=A1+B1") "c5" "input" "=SUM(A1:B2)") "c2" "input" "=SUM(A1:B1)")
        cycle (step s "c0" "input" "=A1")
        minus (step s "c6" "input" "=A1-B1")
        times (step s "c7" "input" "=-3*B1")
        bad (step s "c8" "input" "=A1*B1*C1")
        signs (step s "c9" "input" "=-3--4")
        overflow (step (step (init) "c0" "input" "999999") "c1" "input" "=A1*1001")
        cyclic-product (step s "c10" "input" "=C3*2")
        unicode-formula (step s "c11" "input" "=日本語")
        unicode-length (step s "c12" "input" "=ああ1234")
        unicode-ref (step s "c13" "input" "=é")
        div-ref (step s "c6" "input" "=B1/A1")
        div-exact (step s "c6" "input" "=-12/B1")
        div-negative (step s "c6" "input" "=12/-3")
        div-zero (step s "c6" "input" "=1/0")
        div-zero-top (step s "c6" "input" "=0/B1")
        div-fraction (step s "c6" "input" "=3/2")
        div-overflow-product (step (step (init) "c0" "input" "=999999*1000") "c1" "input" "=A1/2")
        div-repeat (step s "c6" "input" "=1/3")
        dec-mul (step s "c6" "input" "=1.25*2")
        dec-sign (step s "c6" "input" "=-1/8")
        dec-tiny (step s "c6" "input" "=0.000001*0.000001")
        dec-add (step s "c6" "input" "=0.1+0.2")
        dec-precision (step s "c6" "input" "=1.0000001+2")
        dec-trim (step s "c6" "input" "=1.200000+0.3")
        sum-text (step (step (step (init) "c0" "input" "売上") "c1" "input" "3") "c4" "input" "=SUM(A1:B1)")
        sum-decimal (step sum-text "c0" "input" "1.25")
        sum-error (step sum-text "c0" "input" "#DIV/0!")
        sum-formula-error (step sum-text "c0" "input" "=1/0")
        text-arithmetic (step sum-text "c5" "input" "=A1+1")
        bytes (option-value-of [:option :string] (snap-encode s) "")
        restored (snap-decode bytes)]
    (if (and (string=? (shown s 4) "7") (string=? (shown s 2) "7") (string=? (shown s 5) "#ERROR")
             (string=? (shown cycle 0) "#ERROR") (string=? (shown s 0) "3")
             (string=? (shown minus 6) "-1") (string=? (shown times 7) "-12")
             (string=? (shown bad 8) "#ERROR") (string=? (shown signs 9) "1")
             (string=? (shown overflow 1) "#ERROR") (string=? (shown cyclic-product 10) "#ERROR")
             (string=? (shown div-ref 6) "#ERROR") (string=? (shown div-exact 6) "-3")
             (string=? (shown div-negative 6) "-4") (string=? (shown div-zero 6) "#ERROR")
             (string=? (shown div-zero-top 6) "0") (string=? (shown div-fraction 6) "1.5")
             (string=? (shown div-overflow-product 1) "499999500")
             (string=? (shown div-repeat 6) "#ERROR") (string=? (shown dec-mul 6) "2.5")
             (string=? (shown dec-sign 6) "-0.125") (string=? (shown dec-tiny 6) "#ERROR")
             (string=? (shown dec-add 6) "0.3") (string=? (shown dec-precision 6) "#ERROR")
             (string=? (shown dec-trim 6) "1.5")
             (string=? (shown unicode-formula 11) "#ERROR")
             (string=? (shown unicode-length 12) "#ERROR") (string=? (shown unicode-ref 13) "#ERROR")
             (string=? (shown sum-text 4) "3") (string=? (shown sum-decimal 4) "4.25")
             (string=? (shown sum-error 4) "#ERROR") (string=? (shown sum-formula-error 4) "#ERROR")
             (string=? (shown text-arithmetic 5) "#ERROR")
             (= (ref-index "é") -1)
             (option-some?-of [:option :document] restored)
             (document-equal? s (option-value-of [:option :document] restored (document-null)))
             (not (option-some?-of [:option :document] (snap-decode (string-concat bytes "extra"))))) 0 1)))
;; Versioned candidate state: exactly sixteen bounded, byte-framed strings.
(defn snap-frame [s :string] :string
  (string-concat (string-from-i64 (string-byte-length s)) (string-concat ":" s)))
(defn snap-end [s :string i :i64 end :i64] :bool
  (if (= i end) true
    (if (> i end) false
      (let [c (string-code-point-at s i)
            w (cond (< c 128) 1 (< c 2048) 2 (< c 65536) 3 :else 4)]
        (snap-end s (+ i w) end)))))

(defn snap-header [s :string i :i64 n :i64 value :i64 digits :i64 zero :bool] :vector-i64
  (if (>= i n) [-1 -1 -1]
    (let [c (string-code-point-at s i)]
      (cond
        (= c 58) (let [begin (+ i 1) end (+ begin value)]
          (if (and (> digits 0) (<= value 1024) (<= end n) (snap-end s begin end))
            [begin end end] [-1 -1 -1]))
        (or (< c 48) (> c 57) (>= digits 4) (and zero (> digits 0))) [-1 -1 -1]
        :else (snap-header s (+ i 1) n (+ (* value 10) (- c 48)) (+ digits 1) (and (= digits 0) (= c 48)))))))

(defn snap-read [s :string i :i64] :vector-i64
  (snap-header s i (string-byte-length s) 0 0 false))

(defn snap-text [s :string r :vector-i64] :string
  (string-substring s (vector-at r 0) (vector-at r 1)))


(defn snap-encode-cells [s :document i :i64 acc :string] [:option :string]
  (if (= i 16) (option-some-of [:option :string] acc)
    (let [d (dat s i)]
      (if (and (string? d) (<= (string-byte-length (dstr d)) 128))
        (snap-encode-cells s (+ i 1) (string-concat acc (snap-frame (dstr d))))
        (option-none-of [:option :string])))))
(defn snap-encode [s :document] [:option :string]
  (if (and (vector? s) (= (document-count s) 16)) (snap-encode-cells s 0 "HS1|")
    (option-none-of [:option :string])))
(defn snap-decode-cells [s :string pos :i64 i :i64 acc :document] [:option :document]
  (if (= i 16)
    (if (= pos (string-byte-length s)) (option-some-of [:option :document] acc) (option-none-of [:option :document]))
    (let [r (snap-read s pos)]
      (if (or (< (vector-at r 0) 0) (> (- (vector-at r 1) (vector-at r 0)) 128))
        (option-none-of [:option :document])
        (snap-decode-cells s (vector-at r 2) (+ i 1) (document-vector-conj acc (document-string (snap-text s r))))))))
(defn snap-decode [s :string] [:option :document]
  (if (or (< (string-byte-length s) 4) (not (string=? (string-substring s 0 4) "HS1|")))
    (option-none-of [:option :document]) (snap-decode-cells s 4 0 (document-vector))))
(defn main [] :i64 (test-sheet))
