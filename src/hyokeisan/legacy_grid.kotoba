(ns hyokeisan.legacy-grid
  (:export [legacy-grid-cells legacy-grid-find legacy-grid-match-titles])
  (:require [hyokeisan.json-string :as js]
            [hyokeisan.workbook :as workbook]))

;; Strict parser for one raw legacy grid matrix. Return row-major sparse HW3
;; cell frames only; caller must retain the original and validate the workbook.
;; This is a parser building block, not an authenticated export or migration.
(defn lg-width [c :i64] :i64
  (cond (< c 128) 1 (< c 2048) 2 (< c 65536) 3 :else 4))
(defn lg-space [s :string i :i64 n :i64] :i64
  (loop [p i]
    (if (>= p n) p
      (let [c (string-code-point-at s p)]
        (if (or (= c 32) (= c 9) (= c 10) (= c 13)) (recur (+ p 1)) p)))))
(defn lg-string-end [s :string i :i64 n :i64] :i64
  (loop [p (+ i 1)]
    (if (or (>= p n) (> (- p i) 8192)) -1
      (let [c (string-code-point-at s p)]
        (cond (= c 34) (+ p 1)
              (< c 32) -1
              (= c 92) (if (>= (+ p 1) n) -1
                           (if (>= (string-code-point-at s (+ p 1)) 128) -1 (recur (+ p 2))))
              :else (recur (+ p (lg-width c))))))))
(defn lg-rows [s :string pos :i64 n :i64 row :i64 acc :string first :bool] [:option :string]
  (let [p (lg-space s pos n)]
    (if (>= p n) (option-none-of [:option :string])
      (let [c (string-code-point-at s p)]
        (cond (= c 93) (if (and first (= (lg-space s (+ p 1) n) n))
                         (option-some-of [:option :string] acc) (option-none-of [:option :string]))
              (or (not= c 91) (> row 1048576)) (option-none-of [:option :string])
              :else (lg-cells s (+ p 1) n row 1 acc true))))))
(defn lg-after-row [s :string pos :i64 n :i64 row :i64 acc :string] [:option :string]
  (let [p (lg-space s pos n)]
    (if (>= p n) (option-none-of [:option :string])
      (let [c (string-code-point-at s p)]
        (cond (= c 93) (if (= (lg-space s (+ p 1) n) n) (option-some-of [:option :string] acc) (option-none-of [:option :string]))
              (= c 44) (lg-rows s (+ p 1) n (+ row 1) acc false)
              :else (option-none-of [:option :string]))))))
(defn lg-cells [s :string pos :i64 n :i64 row :i64 col :i64 acc :string first :bool] [:option :string]
  (let [p (lg-space s pos n)]
    (if (>= p n) (option-none-of [:option :string])
      (let [c (string-code-point-at s p)]
        (cond (= c 93) (if first (lg-after-row s (+ p 1) n row acc) (option-none-of [:option :string]))
              (or (not= c 34) (> col 16384)) (option-none-of [:option :string])
              :else (let [end (lg-string-end s p n)]
                (if (< end 0) (option-none-of [:option :string])
                  (let [v (js/json-unquote (string-substring s p end))]
                    (if (not (option-some?-of [:option :string] v)) (option-none-of [:option :string])
                      (let [value (option-value-of [:option :string] v "")
                            next (if (= (string-byte-length value) 0) acc
                                     (string-concat acc (workbook/wf-cell row col value)))
                            q (lg-space s end n)]
                        (if (>= q n) (option-none-of [:option :string])
                          (let [d (string-code-point-at s q)]
                            (cond (= d 93) (lg-after-row s (+ q 1) n row next)
                                  (= d 44) (lg-cells s (+ q 1) n row (+ col 1) next false)
                                  :else (option-none-of [:option :string]))))))))))))))
(defn legacy-grid-cells [s :string] [:option :string]
  (let [n (string-byte-length s) p (lg-space s 0 n)]
    (if (or (> n 35000) (>= p n)) (option-none-of [:option :string])
      (if (= (string-code-point-at s p) 91) (lg-rows s (+ p 1) n 1 "" true)
        (option-none-of [:option :string])))))

;; Locate the complete matrix token without materializing a document vector.
;; Full syntax is subsequently checked by legacy-grid-cells, not this scan.
(defn lg-matrix-end [s :string start :i64 n :i64] :i64
  (loop [p start depth 0]
    (if (>= p n) -1
      (let [c (string-code-point-at s p)]
        (cond (= c 34) (let [end (lg-string-end s p n)]
                         (if (< end 0) -1 (recur end depth)))
              (= c 91) (if (>= depth 2) -1 (recur (+ p 1) (+ depth 1)))
              (= c 93) (if (<= depth 0) -1
                         (if (= depth 1) (+ p 1) (recur (+ p 1) (- depth 1))))
              :else (recur (+ p (lg-width c)) depth))))))
(defn lg-seen? [seen :string name :string] :bool
  (loop [p 0]
    (if (= p (string-byte-length seen)) false
      (let [f (workbook/wf-read seen p)]
        (if (< (workbook/wf-start f) 0) true
          (if (string=? (workbook/wf-text seen f) name) true
            (recur (workbook/wf-end f))))))))
(defn lg-object [s :string pos :i64 n :i64 wanted :string seen :string
                 found :bool result :string first :bool count :i64 count-mode :bool] [:option :string]
  (let [p (lg-space s pos n)]
    (if (>= p n) (option-none-of [:option :string])
      (let [c (string-code-point-at s p)]
        (cond (= c 125) (if (and first (= (lg-space s (+ p 1) n) n) (or count-mode found))
                          (option-some-of [:option :string] (if count-mode (string-from-i64 count) result))
                          (option-none-of [:option :string]))
              (not= c 34) (option-none-of [:option :string])
              :else (let [end (lg-string-end s p n)]
                (if (< end 0) (option-none-of [:option :string])
                  (let [name (js/json-unquote (string-substring s p end))
                        colon (lg-space s end n)]
                    (if (or (not (option-some?-of [:option :string] name)) (>= colon n)) (option-none-of [:option :string])
                      (let [key (option-value-of [:option :string] name "")]
                        (if (or (> (string-byte-length key) 1024) (lg-seen? seen key)
                                (not (= (string-code-point-at s colon) 58))) (option-none-of [:option :string])
                          (let [begin (lg-space s (+ colon 1) n)]
                            (if (or (>= begin n) (not (= (string-code-point-at s begin) 91))) (option-none-of [:option :string])
                              (let [stop (lg-matrix-end s begin n)]
                                (if (< stop 0) (option-none-of [:option :string])
                                  (let [cells (legacy-grid-cells (string-substring s begin stop))
                                        q (lg-space s stop n)]
                                    (if (or (not (option-some?-of [:option :string] cells)) (>= q n)) (option-none-of [:option :string])
                                      (let [hit (string=? key wanted) more (string-code-point-at s q)
                                            value (if hit (option-value-of [:option :string] cells "") result)]
                                        (cond (= more 125) (if (and (or count-mode found hit) (= (lg-space s (+ q 1) n) n))
                                                             (option-some-of [:option :string] (if count-mode (string-from-i64 (+ count 1)) value)) (option-none-of [:option :string]))
                                              (= more 44) (lg-object s (+ q 1) n wanted
                                                            (string-concat seen (workbook/wf-frame key)) (or found hit) value false (+ count 1) count-mode)
                                              :else (option-none-of [:option :string]))))))))))))))))))))
(defn legacy-grid-find [s :string wanted :string] [:option :string]
  (let [n (string-byte-length s) p (lg-space s 0 n)]
    (if (or (> n 35000) (>= p n)) (option-none-of [:option :string])
      (if (= (string-code-point-at s p) 123) (lg-object s (+ p 1) n wanted "" false "" true 0 false)
        (option-none-of [:option :string])))))

;; Metadata titles arrive as a sequence of canonical length-prefixed UTF-8
;; strings. The metadata parser is responsible for constructing this input;
;; this function proves set equality, but not export origin or revision.
(defn lg-match-from [grid :string titles :string pos :i64 seen :string count :i64 expected :string] :bool
  (if (= pos (string-byte-length titles)) (string=? (string-from-i64 count) expected)
    (let [f (workbook/wf-read titles pos)]
      (if (< (workbook/wf-start f) 0) false
        (let [title (workbook/wf-text titles f)]
          (if (or (> (string-byte-length title) 1024) (lg-seen? seen title)
                  (not (option-some?-of [:option :string] (legacy-grid-find grid title)))) false
            (lg-match-from grid titles (workbook/wf-end f) (string-concat seen (workbook/wf-frame title)) (+ count 1) expected)))))))
(defn legacy-grid-match-titles [grid :string titles :string] :bool
  (let [n (string-byte-length grid) p (lg-space grid 0 n)]
    (if (or (> n 35000) (> (string-byte-length titles) 35000) (>= p n)) false
      (if (not (= (string-code-point-at grid p) 123)) false
        (let [count (lg-object grid (+ p 1) n "" "" false "" true 0 true)]
          (if (not (option-some?-of [:option :string] count)) false
            (lg-match-from grid titles 0 "" 0 (option-value-of [:option :string] count ""))))))))
