(ns hyokeisan.json-parse
  (:export [json-parse json-object-field json-array-item json-array-tokens])
  (:require [hyokeisan.json-string :as js]))

;; Based on Bunsho src/moji/json_parse.kotoba at 09f425164e2af3985a12fa661970673ac70e16d6.
;; Strict bounded JSON validation for legacy import. Successful output preserves
;; the exact input text, including unknown fields and original number lexemes.
;; The module imports hyokeisan.json-string; the native/browser fixture stages it.
;; Limits are provisional and refusal is not a successful migration.
(defn jp-width [c :i64] :i64
  (cond (< c 128) 1 (< c 2048) 2 (< c 65536) 3 :else 4))
(defn jp-space [s :string i :i64 n :i64] :i64
  (loop [at i]
    (if (>= at n) at
      (let [c (string-code-point-at s at)]
        (if (or (= c 32) (= c 9) (= c 10) (= c 13)) (recur (+ at 1)) at)))))
(defn jp-string-end [s :string i :i64 n :i64 start :i64] :i64
  (loop [at i]
    (if (or (>= at n) (>= (- at start) 35000)) -1
      (let [c (string-code-point-at s at)]
        (cond (= c 34) (+ at 1)
              (< c 32) -1
              (= c 92) (if (>= (+ at 1) n) -1
                         (let [e (string-code-point-at s (+ at 1))]
                           (recur (+ at 1 (jp-width e)))))
              :else (recur (+ at (jp-width c))))))))

(defn jp-string [s :string i :i64 n :i64] :i64
  (let [end (jp-string-end s (+ i 1) n i)]
    (if (< end 0) -1
      (if (option-some?-of [:option :string] (js/json-unquote (string-substring s i end))) end -1))))
(defn jp-digit? [c :i64] :bool (and (>= c 48) (<= c 57)))
(defn jp-digits [s :string i :i64 n :i64] :i64
  (loop [at i]
    (if (and (< at n) (jp-digit? (string-code-point-at s at))) (recur (+ at 1)) at)))
(defn jp-number-end [s :string start :i64 n :i64] :i64
  (let [i (if (= (string-code-point-at s start) 45) (+ start 1) start)]
    (if (>= i n) -1
      (let [c (string-code-point-at s i)
            after-int (cond (= c 48) (+ i 1) (and (>= c 49) (<= c 57)) (jp-digits s (+ i 1) n) :else -1)]
        (if (< after-int 0) -1
          (let [dot (and (< after-int n) (= (string-code-point-at s after-int) 46))
                after-frac (if dot (jp-digits s (+ after-int 1) n) after-int)]
            (if (and dot (= after-frac (+ after-int 1))) -1
              (let [has-exp (and (< after-frac n) (or (= (string-code-point-at s after-frac) 101) (= (string-code-point-at s after-frac) 69)))
                    e0 (if has-exp (+ after-frac 1) after-frac)
                    signed (and has-exp (< e0 n) (or (= (string-code-point-at s e0) 43) (= (string-code-point-at s e0) 45)))
                    e1 (if signed (+ e0 1) e0)
                    e2 (if has-exp (jp-digits s e1 n) after-frac)]
                (if (and has-exp (= e1 e2)) -1 e2)))))))))
(defn jp-key [v :document i :i64] :string
  (option-value-of [:option :string] (document-string-value
    (option-value-of [:option :document] (document-vector-at v i) (document-null))) ""))
(defn jp-contains-key [v :document key :string i :i64] :bool
  (if (>= i (document-count v)) false
    (if (string=? (jp-key v i) key) true (jp-contains-key v key (+ i 1)))))
(defn jp-array [s :string i :i64 n :i64 depth :i64 count :i64 first :bool] :i64
  (let [at (jp-space s i n)]
    (if (>= at n) -1
      (let [c (string-code-point-at s at)]
        (if (= c 93) (if first (+ at 1) -1)
          (if (>= count 32) -1
            (let [value-end (jp-value s at n depth)]
              (if (< value-end 0) -1
                (let [next (jp-space s value-end n)]
                  (if (>= next n) -1
                    (let [d (string-code-point-at s next)]
                      (cond (= d 93) (+ next 1)
                            (= d 44) (jp-array s (+ next 1) n depth (+ count 1) false)
                            :else -1))))))))))))
(defn jp-object [s :string i :i64 n :i64 depth :i64 keys :document first :bool] :i64
  (let [at (jp-space s i n)]
    (if (>= at n) -1
      (let [c (string-code-point-at s at)]
        (if (= c 125) (if first (+ at 1) -1)
          (if (or (not (= c 34)) (>= (document-count keys) 32)) -1
            (let [end (jp-string s at n)]
              (if (< end 0) -1
                (let [key-opt (js/json-unquote (string-substring s at end))
                      key (option-value-of [:option :string] key-opt "")
                      colon (jp-space s end n)]
                  (if (or (jp-contains-key keys key 0) (>= colon n) (not (= (string-code-point-at s colon) 58))) -1
                    (let [value-at (jp-space s (+ colon 1) n)
                          value-end (jp-value s value-at n depth)]
                      (if (< value-end 0) -1
                        (let [next (jp-space s value-end n)
                              new-keys (document-vector-conj keys (document-string key))]
                          (if (>= next n) -1
                            (let [d (string-code-point-at s next)]
                              (cond (= d 125) (+ next 1)
                                    (= d 44) (jp-object s (+ next 1) n depth new-keys false)
                                    :else -1))))))))))))))))
(defn jp-literal-match [s :string i :i64 n :i64 literal :string at :i64] :bool
  (if (= at (string-byte-length literal)) true
    (if (>= i n) false
      (if (= (string-code-point-at s i) (string-code-point-at literal at))
        (jp-literal-match s (+ i 1) n literal (+ at 1)) false))))
(defn jp-literal [s :string i :i64 n :i64 literal :string] :i64
  (if (jp-literal-match s i n literal 0) (+ i (string-byte-length literal)) -1))
(defn jp-value [s :string i :i64 n :i64 depth :i64] :i64
  (if (or (>= i n) (> depth 16)) -1
    (let [c (string-code-point-at s i)]
      (cond (= c 34) (jp-string s i n)
            (= c 91) (if (>= depth 16) -1 (jp-array s (+ i 1) n (+ depth 1) 0 true))
            (= c 123) (if (>= depth 16) -1 (jp-object s (+ i 1) n (+ depth 1) (document-vector) true))
            (= c 116) (jp-literal s i n "true")
            (= c 102) (jp-literal s i n "false")
            (= c 110) (jp-literal s i n "null")
            (or (= c 45) (jp-digit? c)) (jp-number-end s i n)
            :else -1))))
(defn json-parse [s :string] [:option :string]
  (let [n (string-byte-length s)]
    (if (> n 35000) (option-none-of [:option :string])
      (let [start (jp-space s 0 n) end (jp-value s start n 0)]
        (if (or (< end 0) (not (= (jp-space s end n) n)))
          (option-none-of [:option :string]) (option-some-of [:option :string] s))))))

;; These accessors first validate the entire input, including duplicate keys.
;; A returned token is an exact slice; null is the token "null", distinct from
;; an absent key or index. Nested containers may be passed back to an accessor.
(defn jp-object-field-from [s :string i :i64 n :i64 key :string] [:option :string]
  (let [at (jp-space s i n)]
    (if (or (>= at n) (not (= (string-code-point-at s at) 34))) (option-none-of [:option :string])
      (let [end (jp-string s at n)]
        (if (< end 0) (option-none-of [:option :string])
          (let [decoded (js/json-unquote (string-substring s at end))
                colon (jp-space s end n)]
            (if (or (not (option-some?-of [:option :string] decoded)) (>= colon n)
                    (not (= (string-code-point-at s colon) 58))) (option-none-of [:option :string])
              (let [start (jp-space s (+ colon 1) n) stop (jp-value s start n 1)]
                (if (< stop 0) (option-none-of [:option :string])
                  (if (string=? (option-value-of [:option :string] decoded "") key)
                    (option-some-of [:option :string] (string-substring s start stop))
                    (let [next (jp-space s stop n)]
                      (if (and (< next n) (= (string-code-point-at s next) 44))
                        (jp-object-field-from s (+ next 1) n key) (option-none-of [:option :string])))))))))))))
(defn json-object-field [s :string key :string] [:option :string]
  (let [valid (json-parse s) n (string-byte-length s) start (jp-space s 0 n)]
    (if (or (not (option-some?-of [:option :string] valid)) (>= start n)
            (not (= (string-code-point-at s start) 123))) (option-none-of [:option :string])
      (jp-object-field-from s (+ start 1) n key))))
(defn jp-array-item-from [s :string i :i64 n :i64 wanted :i64 index :i64] [:option :string]
  (let [start (jp-space s i n)]
    (if (or (>= start n) (= (string-code-point-at s start) 93)) (option-none-of [:option :string])
      (let [stop (jp-value s start n 1)]
        (if (< stop 0) (option-none-of [:option :string])
          (if (= index wanted) (option-some-of [:option :string] (string-substring s start stop))
            (let [next (jp-space s stop n)]
              (if (and (< next n) (= (string-code-point-at s next) 44))
                (jp-array-item-from s (+ next 1) n wanted (+ index 1)) (option-none-of [:option :string])))))))))
(defn json-array-item [s :string index :i64] [:option :string]
  (let [valid (json-parse s) n (string-byte-length s) start (jp-space s 0 n)]
    (if (or (< index 0) (not (option-some?-of [:option :string] valid)) (>= start n)
            (not (= (string-code-point-at s start) 91))) (option-none-of [:option :string])
      (jp-array-item-from s (+ start 1) n index 0))))

;; Validate the complete array once and return exact item tokens. The flat
;; vector avoids repeating a full-array validation for every legacy block.
(defn jp-array-tokens-from [s :string i :i64 n :i64 acc :document] [:option :document]
  (let [start (jp-space s i n)]
    (if (>= start n) (option-none-of [:option :document])
      (if (= (string-code-point-at s start) 93) (option-some-of [:option :document] acc)
        (let [stop (jp-value s start n 1)]
          (if (< stop 0) (option-none-of [:option :document])
            (let [next (jp-space s stop n)
                  items (document-vector-conj acc (document-string (string-substring s start stop)))]
              (if (>= next n) (option-none-of [:option :document])
                (cond (= (string-code-point-at s next) 93) (option-some-of [:option :document] items)
                      (= (string-code-point-at s next) 44) (jp-array-tokens-from s (+ next 1) n items)
                      :else (option-none-of [:option :document]))))))))))
(defn json-array-tokens [s :string] [:option :document]
  (if (not (option-some?-of [:option :string] (json-parse s))) (option-none-of [:option :document])
    (let [n (string-byte-length s) start (jp-space s 0 n)]
      (if (>= start n) (option-none-of [:option :document])
        (if (not (= (string-code-point-at s start) 91)) (option-none-of [:option :document])
          (jp-array-tokens-from s (+ start 1) n (document-vector)))))))
