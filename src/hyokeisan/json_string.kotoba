(ns hyokeisan.json-string
  (:export [json-unquote]))

;; Based on Bunsho src/moji/json_string.kotoba at 09f425164e2af3985a12fa661970673ac70e16d6.
;; Decode one complete JSON string token. Indices are UTF-8 byte offsets.
;; Tokens are capped at 35000 UTF-8 bytes. This is a migration building block,
;; not an old-document parser or importer.
(defn json-hex [c :i64] :i64
  (cond (and (>= c 48) (<= c 57)) (- c 48)
        (and (>= c 65) (<= c 70)) (+ 10 (- c 65))
        (and (>= c 97) (<= c 102)) (+ 10 (- c 97))
        :else -1))

(defn json-hex4-from [s :string i :i64 end :i64 left :i64 acc :i64] :i64
  (if (= left 0) acc
    (if (>= i end) -1
      (let [digit (json-hex (string-code-point-at s i))]
        (if (< digit 0) -1
          (json-hex4-from s (+ i 1) end (- left 1) (+ (* acc 16) digit)))))))

(defn json-hex4 [s :string i :i64 end :i64] :i64
  (json-hex4-from s i end 4 0))

(defn json-codepoint [cp :i64] :string
  (string-from-utf8
    (bytes-from-vector-i64
      (cond (< cp 128) [cp]
            (< cp 2048) [(+ 192 (quot cp 64)) (+ 128 (bit-and cp 63))]
            (< cp 65536) [(+ 224 (quot cp 4096)) (+ 128 (bit-and (quot cp 64) 63)) (+ 128 (bit-and cp 63))]
            :else [(+ 240 (quot cp 262144)) (+ 128 (bit-and (quot cp 4096) 63))
                   (+ 128 (bit-and (quot cp 64) 63)) (+ 128 (bit-and cp 63))]))))

(defn json-unquote-from [s :string i :i64 end :i64 acc :string] [:option :string]
  (if (>= i end) (option-none-of [:option :string])
    (let [c (string-code-point-at s i)]
      (cond
        (= c 34) (if (= (+ i 1) end) (option-some-of [:option :string] acc) (option-none-of [:option :string]))
        (< c 32) (option-none-of [:option :string])
        (= c 92)
          (if (>= (+ i 1) end) (option-none-of [:option :string])
            (let [e (string-code-point-at s (+ i 1))]
              (if (= e 117)
                (let [u (json-hex4 s (+ i 2) end)]
                  (cond
                    (< u 0) (option-none-of [:option :string])
                    (and (>= u 55296) (<= u 56319))
                      (if (or (> (+ i 12) end)
                              (not (= (string-code-point-at s (+ i 6)) 92))
                              (not (= (string-code-point-at s (+ i 7)) 117)))
                        (option-none-of [:option :string])
                        (let [v (json-hex4 s (+ i 8) end)]
                          (if (or (< v 56320) (> v 57343)) (option-none-of [:option :string])
                            (json-unquote-from s (+ i 12) end
                              (string-concat acc (json-codepoint (+ 65536 (* (- u 55296) 1024) (- v 56320))))))))
                    (and (>= u 56320) (<= u 57343)) (option-none-of [:option :string])
                    :else (json-unquote-from s (+ i 6) end (string-concat acc (json-codepoint u)))))
                (let [cp (cond (= e 34) 34 (= e 92) 92 (= e 47) 47 (= e 98) 8 (= e 102) 12
                               (= e 110) 10 (= e 114) 13 (= e 116) 9 :else -1)]
                  (if (< cp 0) (option-none-of [:option :string])
                    (json-unquote-from s (+ i 2) end (string-concat acc (json-codepoint cp))))))))
        :else (let [width (cond (< c 128) 1 (< c 2048) 2 (< c 65536) 3 :else 4)]
                (json-unquote-from s (+ i width) end
                  (string-concat acc (string-substring s i (+ i width)))))))))

;; Split only between complete UTF-8 characters and escape sequences. Decode
;; bounded leaves and combine them as a balanced tree, avoiding quadratic
;; copying of a growing accumulator for long escaped response strings.
(defn json-token-next [s :string p :i64 end :i64] :i64
  (let [c (string-code-point-at s p)]
    (if (not (= c 92))
      (+ p (cond (< c 128) 1 (< c 2048) 2 (< c 65536) 3 :else 4))
      (if (>= (+ p 1) end) -1
        (if (not (= (string-code-point-at s (+ p 1)) 117)) (+ p 2)
          (if (> (+ p 6) end) -1
            (let [u (json-hex4 s (+ p 2) end)]
              (if (and (>= u 55296) (<= u 56319))
                (if (or (> (+ p 12) end) (not (= (string-code-point-at s (+ p 6)) 92))
                        (not (= (string-code-point-at s (+ p 7)) 117))) -1 (+ p 12))
                (+ p 6)))))))))
(defn json-split [s :string p :i64 end :i64 target :i64] :i64
  (if (or (>= p target) (>= p end)) p
    (let [next (json-token-next s p end)]
      (if (or (< next 0) (> next end)) -1 (json-split s next end target)))))
(defn json-balanced [s :string start :i64 end :i64] [:option :string]
  (if (<= (- end start) 64)
    (let [token (string-concat "\"" (string-concat (string-substring s start end) "\""))]
      (json-unquote-from token 1 (string-byte-length token) ""))
    (let [mid (json-split s start end (+ start (quot (- end start) 2)))]
      (if (or (<= mid start) (>= mid end)) (option-none-of [:option :string])
        (let [left (json-balanced s start mid) right (json-balanced s mid end)]
          (if (and (option-some?-of [:option :string] left) (option-some?-of [:option :string] right))
            (option-some-of [:option :string] (string-concat (option-value-of [:option :string] left "")
                                                            (option-value-of [:option :string] right "")))
            (option-none-of [:option :string])))))))
(defn json-final-quote? [s :string p :i64 n :i64] :bool
  (if (>= p n) false
    (let [c (string-code-point-at s p)]
      (if (= c 34) (= (+ p 1) n)
        (let [next (json-token-next s p n)]
          (if (or (< next 0) (> next n)) false (json-final-quote? s next n)))))))

;; Decode into a single exact-size byte vector. Each scoped step retains only
;; its scalar offsets while mutations to the outer vector survive the scope.
;; The first pass validates and counts; malformed input returns no value.
(defn json-buffer-emit [v :vector-i64 j :i64 cp :i64 write :bool] :i64
  (let [width (cond (< cp 128) 1 (< cp 2048) 2 (< cp 65536) 3 :else 4)]
    (if (not write) (+ j width)
      (let [b0 (cond (= width 1) cp (= width 2) (+ 192 (quot cp 64)) (= width 3) (+ 224 (quot cp 4096)) :else (+ 240 (quot cp 262144)))
            r0 (vector-assoc! v j b0)
            r1 (if (>= width 2) (vector-assoc! v (+ j 1) (+ 128 (bit-and (quot cp (if (= width 4) 4096 (if (= width 3) 64 1))) 63))) v)
            r2 (if (>= width 3) (vector-assoc! v (+ j 2) (+ 128 (bit-and (quot cp (if (= width 4) 64 1)) 63))) v)
            r3 (if (= width 4) (vector-assoc! v (+ j 3) (+ 128 (bit-and cp 63))) v)]
        (+ j width)))))
(defn json-buffer-step [s :string i :i64 end :i64 v :vector-i64 j :i64 write :bool] :i64
  (let [c (string-code-point-at s i)]
    (if (or (< c 32) (= c 34)) -1
      (if (not (= c 92))
        (let [next (+ i (cond (< c 128) 1 (< c 2048) 2 (< c 65536) 3 :else 4))
              out (json-buffer-emit v j c write)]
          (if (> next end) -1 (+ (* next 65536) out)))
        (if (>= (+ i 1) end) -1
          (let [e (string-code-point-at s (+ i 1))]
            (if (= e 117)
              (let [u (json-hex4 s (+ i 2) end)]
                (cond (< u 0) -1
                      (and (>= u 55296) (<= u 56319))
                        (if (or (> (+ i 12) end) (not (= (string-code-point-at s (+ i 6)) 92)) (not (= (string-code-point-at s (+ i 7)) 117))) -1
                          (let [z (json-hex4 s (+ i 8) end)]
                            (if (or (< z 56320) (> z 57343)) -1
                              (+ (* (+ i 12) 65536) (json-buffer-emit v j (+ 65536 (* (- u 55296) 1024) (- z 56320)) write)))))
                      (and (>= u 56320) (<= u 57343)) -1
                      :else (+ (* (+ i 6) 65536) (json-buffer-emit v j u write))))
              (let [cp (cond (= e 34) 34 (= e 92) 92 (= e 47) 47 (= e 98) 8 (= e 102) 12 (= e 110) 10 (= e 114) 13 (= e 116) 9 :else -1)]
                (if (< cp 0) -1 (+ (* (+ i 2) 65536) (json-buffer-emit v j cp write)))))))))))
(defn json-buffer-walk [s :string i :i64 end :i64 v :vector-i64 j :i64 write :bool] :i64
  (cond (= i end) j (> i end) -1
        :else (let [step (arena-scope (json-buffer-step s i end v j write))]
                (if (< step 0) -1
                  (json-buffer-walk s (quot step 65536) end v (rem step 65536) write)))))
(defn json-unquote-small [s :string] [:option :string]
  (let [n (string-byte-length s)]
    (if (or (< n 2) (> n 35000) (not (= (string-code-point-at s 0) 34)))
      (option-none-of [:option :string])
      (if (not (json-final-quote? s 1 n)) (option-none-of [:option :string])
        (json-balanced s 1 (- n 1))))))

(defn json-unquote-buffered [s :string] [:option :string]
  (let [n (string-byte-length s)]
    (if (or (< n 2) (> n 35000) (not (= (string-code-point-at s 0) 34)) (not (= (string-code-point-at s (- n 1)) 34)))
      (option-none-of [:option :string])
      (let [len (json-buffer-walk s 1 (- n 1) (vector-alloc 0) 0 false)]
        (if (< len 0) (option-none-of [:option :string])
          (let [out (vector-alloc len) written (json-buffer-walk s 1 (- n 1) out 0 true)]
            (if (not (= written len)) (option-none-of [:option :string])
              (option-some-of [:option :string] (string-from-utf8 (bytes-from-vector-i64 out))))))))))

;; Short strings use the existing balanced decoder to avoid retaining a new
;; vector per cell. The bounded buffer path is reserved for longer inputs.
(defn json-unquote [s :string] [:option :string]
  (if (<= (string-byte-length s) 1024) (json-unquote-small s)
    (json-unquote-buffered s)))
