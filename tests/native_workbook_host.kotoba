(ns hyokeisan.native-workbook-host
  (:export [main])
  (:require [hyokeisan.sheet :as sheet]))
(defn main [] :i64
  (let [initial (sheet/init)
        changed (sheet/step initial "c0" "input" "表😀\n二行")
        base (sheet/snap-encode changed)
        hs1 (option-value-of [:option :string] base "")
        protected (sheet/browser-wrap base)
        hx1 (option-value-of [:option :string] protected "")
        unpacked (sheet/browser-unpack hx1)
        workbook (sheet/ui-from-hs1 (option-value-of [:option :string] unpacked ""))
        ui (option-value-of [:option :string] workbook "")
        formula (sheet/ui-step ui "c1" "input" "=3/2")
        first-ui (option-value-of [:option :string] formula "")
        added (sheet/ui-step first-ui "sheet-add" "click" "")
        second-ui (option-value-of [:option :string] added "")
        returned (sheet/ui-step second-ui "sheet-prev" "click" "")
        final-ui (option-value-of [:option :string] returned "")
        screen (sheet/ui-view final-ui)
        view (if (option-some?-of [:option :document] screen)
               (sheet/browser-view-node (option-value-of [:option :document] screen (document-null)) "BV2|") "")
        wrapped (sheet/browser-wrap returned)
        final-raw (option-value-of [:option :string] wrapped "")
        restored (sheet/browser-unpack final-raw)]
    (if (and (option-some?-of [:option :string] base)
             (option-some?-of [:option :string] protected)
             (= (string-index-of hx1 "HX1|1") 0)
             (string=? (option-value-of [:option :string] unpacked "") hs1)
             (option-some?-of [:option :string] workbook)
             (option-some?-of [:option :string] formula)
             (option-some?-of [:option :string] added)
             (option-some?-of [:option :string] returned)
             (not (string=? second-ui first-ui))
             (option-some?-of [:option :document] screen)
             (>= (string-index-of view "表😀\n二行") 0)
             (>= (string-index-of view "1.5") 0)
             (option-some?-of [:option :string] wrapped)
             (= (string-index-of final-raw "HX1|2") 0)
             (string=? (option-value-of [:option :string] restored "") final-ui)
             (not (option-some?-of [:option :string] (sheet/browser-protect (string-concat final-raw "x"))))) 0 1)))
